+// Offline navigation contract: retiring Clip must not retire its APIs or result detail URLs.
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import path from 'node:path'
+import { createRequire } from 'node:module'
+
+const require = createRequire(import.meta.url)
+const ts = require('typescript')
+const React = require('react')
+const { renderToStaticMarkup } = require('react-dom/server')
+const root = path.resolve(import.meta.dirname, '..')
+const read = file => fs.readFileSync(path.join(root, file), 'utf8')
+const cache = new Map()
+const link = ({ href, children, ...props }) => React.createElement('a', { ...props, href }, children)
+const stubs = {
+  'next/link': { __esModule: true, default: link },
+  'app/(dashboard)/library/LibraryClient': { __esModule: true, default: () => null },
+  'components/library/VideoCollection': { __esModule: true, default: () => null },
+  'components/growth/MrrReactivationReturn': { __esModule: true, default: () => null },
+}
+function load(file) {
+  if (stubs[file]) return stubs[file]
+  if (file.endsWith('.css')) return {}
+  const filename = /\.[cm]?[jt]sx?$/.test(file) ? file : ['.ts', '.tsx'].map(ext => file + ext).find(f => fs.existsSync(path.join(root, f)))
+  assert(filename, `Missing module: ${file}`)
+  if (cache.has(filename)) return cache.get(filename).exports
+  const mod = { exports: {} }; cache.set(filename, mod)
+  const localRequire = name => {
+    if (stubs[name]) return stubs[name]
+    if (name.startsWith('@/')) return load(name.slice(2))
+    if (name.startsWith('.')) return load(path.posix.normalize(path.posix.join(path.posix.dirname(filename), name)))
+    return require(name)
+  }
+  const js = ts.transpileModule(read(filename), { fileName: filename, compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, jsx: ts.JsxEmit.ReactJSX, esModuleInterop: true } }).outputText
+  new Function('require', 'module', 'exports', js)(localRequire, mod, mod.exports)
+  return mod.exports
+}
+
+const redirects = await require('../next.config.js').redirects()
+for (const source of ['/clips', '/create/clip']) {
+  const rules = redirects.filter(rule => rule.source === source)
+  assert.equal(rules.length, 1)
+  assert.deepEqual(rules[0], { source, destination: '/recreate', permanent: true })
+}
+assert(!redirects.some(rule => /\/(?:clips|create\/clip)\//.test(rule.source)), 'No wildcard/detail redirect may retire clip results')
+const nav = load('lib/ui/workspaceNavigation')
+for (const on of [false, true]) {
+  const items = nav.sidebarNavItems(on)
+  assert(!items.some(item => item.href === '/clips' || item.href === '/create/clip'))
+  assert.equal(items.filter(item => item.href === '/recreate').length, 1)
+}
+const Tabs = load('components/create/CreateTabs').default
+for (const showClip of [false, true]) {
+  const html = renderToStaticMarkup(React.createElement(Tabs, { active: 'ads', showRecreate: true, showClip }))
+  assert(!html.includes('data-create-tab="clip"'))
+  assert(html.includes('href="/recreate"'))
+}
+const gallery = load('lib/homeGaleria')
+for (const href of ['/clips', '/clips?engine=hollywood&prompt=Example', '/create/clip?remix=example']) {
+  assert.equal(gallery.viaSignup(href, true), '/recreate')
+  assert.equal(new URLSearchParams(gallery.viaSignup(href, false).split('?')[1]).get('redirect'), '/recreate')
+}
+for (const href of ['/clips/result-id', '/api/clips', '/studio?ideia=Example', '/ads/new']) assert.equal(gallery.viaSignup(href, true), href)
+const clips = load('lib/clipesNos2Lugares')
+for (const clip of clips.CLIPES_NOVOS) assert.equal(clips.clipeNovoDestino(clip), clips.clipeNovoAnuncio(clip) ? '/ads/new' : '/recreate')
+const Library = load('app/(dashboard)/library/page').default
+assert.equal(Library({ searchParams: { tab: 'clips' } }).props.initialTab, 'clips')
+for (const tab of ['invalid', ['clips']]) assert.equal(Library({ searchParams: { tab } }).props.initialTab, undefined)
+assert.equal((read('app/recreate/RecreateClient.tsx').match(/href="\/library\?tab=clips"/g) ?? []).length, 2)
+console.log('Clip retirement: redirects, desktop/mobile navigation, gallery, detail URLs and My videos filter passed (offline).')
