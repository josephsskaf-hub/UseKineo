    {
      "name": "create_video_handoff",
      "title": "Save an approved video script",
      "description": "Saves the narration the user approved. Returns the full script, server word count, duration assessment and a shareable Kineo Studio link. Anyone with the link can read it. The link expires after 7 days. Does not render, publish or charge. Existing Kineo accounts can open the script in Studio.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "description": "The narration exactly as the user approved it, plain text, optionally with HOOK:/MICRO REWARD:/ESCALATION:/PAYOFF: labels."
          },
          "durationSec": {
            "type": "integer",
            "enum": [
              15,
              35,
              60,
              90
            ],
            "default": 60,
            "description": "Target film length in seconds. 15 is available only with engineHint seedance."
          },
          "aspect": {
            "type": "string",
            "enum": [
              "9:16",
              "16:9",
              "1:1",
              "4:5"
            ],
            "default": "9:16",
            "description": "Frame: 9:16 (vertical) for Shorts, TikTok and Reels — use 9:16 unless the user explicitly asks for widescreen/horizontal, square or a feed post; 16:9 for regular YouTube or websites; 1:1 square; 4:5 tall feed post."
          },
          "engineHint": {
            "type": "string",
            "enum": [
              "fast",
              "seedance",
              "kling",
              "veo",
              "hollywood",
              "h3"
            ],
            "default": "seedance",
            "description": "Video engine preselected in Studio: fast = Kineo 1, seedance = Seedance 1.5, kling = Kling 2.5, veo = Veo 3.1, hollywood = Kling 3, h3 = MiniMax H3. Use seedance unless the user explicitly names another engine; words like \"cinematic\" or \"epic\" describe the style, not a request for a different engine. The person can change it in Studio."
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "default": "en",
            "description": "Language of the script as a short code, such as en, pt or es."
          },
          "topic": {
            "type": "string",
            "maxLength": 200,
            "description": "Optional 3-8 word title shown on the link page."
          }
        },
        "required": [
          "script"
        ],
        "additionalProperties": false
      },
